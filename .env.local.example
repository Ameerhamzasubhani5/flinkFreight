# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Your MongoDB connection string (Atlas free tier / M0 works).
#
# Two things to set up on the Atlas side for production:
#   1. Network Access → allow 0.0.0.0/0. Vercel's lambdas have no fixed IP,
#      so an IP allowlist will block the site intermittently.
#   2. Nothing else — the daily /api/health cron (vercel.json) keeps the free
#      cluster from being auto-paused for inactivity.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/flinkfreight

# ─── Resend (email) ──────────────────────────────────────────────────────────
# 1. Sign up free at https://resend.com
# 2. Create an API key under Settings → API Keys
# 3. Paste it here
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Address Resend sends FROM.
# • During development you can use the Resend sandbox: onboarding@resend.dev
#   (emails will only be delivered to the address you signed up with)
# • In production: verify your domain in Resend and use your own address,
#   e.g. noreply@flinkfreight.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# The inbox that receives the contact-form notifications (your team's email)
CONTACT_TO_EMAIL=info@flinkfreight.com

# The inbox that receives career-application notifications.
# Optional — falls back to CONTACT_TO_EMAIL if not set.
CAREER_TO_EMAIL=careers@flinkfreight.com

# ─── Microsoft 365 / Graph (resume + shipment-photo storage) ─────────────────
# Uploads career-application resumes and contact-form shipment photos straight
# into a Microsoft 365 OneDrive mailbox, via app-only (client-credentials)
# Graph API auth. Until these are set, uploaded files are stored in MongoDB
# instead — nothing is lost, it just doesn't leave the database yet.
#
# One-time setup in the Microsoft 365 tenant's Entra ID (Azure AD):
#   1. Register an app (App registrations → New registration).
#   2. Grant it the Graph API APPLICATION permission Files.ReadWrite.All,
#      then have a tenant admin click "Grant admin consent".
#   3. Create a client secret under Certificates & secrets.
#   4. Fill in the four values below.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# The mailbox whose OneDrive receives uploaded files, e.g. a shared
# operations/careers mailbox on the tenant.
MS_GRAPH_USER_EMAIL=
