# ═══════════════════════════════════════════════════════════════════════════
#  Copy this file to .env.local and fill in the values.
#  .env.local is gitignored and must never be committed.
#
#  Everything runs on ONE Microsoft 365 app registration: it stores the
#  uploaded files AND sends the notification emails. There is no database and
#  no third-party email service to set up.
#
#  When done, run:   npm run check
# ═══════════════════════════════════════════════════════════════════════════

# ─── Microsoft 365 credentials ──────────────────────────────────────────────
# One-time setup in the tenant's Entra ID (entra.microsoft.com):
#   1. App registrations → New registration. Leave the redirect URI empty.
#   2. API permissions → Add a permission → Microsoft Graph →
#      APPLICATION permissions (not Delegated). Add both:
#          Files.ReadWrite.All   — storing CVs and photos
#          Mail.Send             — sending the notification emails
#   3. Click "Grant admin consent". The green tick is what matters — without
#      it every call is rejected even though the values below are correct.
#   4. Certificates & secrets → New client secret.
#
# From the app's Overview page:
#   "Anwendungs-ID (Client)"    = Application (client) ID  -> MS_GRAPH_CLIENT_ID
#   "Verzeichnis-ID (Mandant)"  = Directory (tenant) ID    -> MS_GRAPH_TENANT_ID
# From Certificates & secrets, copy the "Wert" / Value column — NOT "Geheime
# ID" / Secret ID, which is useless here and cannot be recovered later.
#
# The secret EXPIRES (24 months max). When it does, uploads and emails stop
# silently. Put the expiry date in a calendar now.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# ─── Email ──────────────────────────────────────────────────────────────────
# The mailbox notifications are sent FROM. Must be a real, licensed mailbox in
# the tenant — its existing Microsoft 365 SPF/DKIM authenticates the mail, so
# there is no DNS work and no domain verification to do.
# A copy of everything sent is kept in this mailbox's Sent Items.
MS_GRAPH_SENDER_EMAIL=info@flinkfreight.de

# The inbox(es) that receive contact-form notifications. Comma-separated —
# every address listed gets every notification (e.g. one per market/language).
CONTACT_TO_EMAIL=info@flinkfreight.de,info@flinkfreight.eu

# The inbox(es) that receive career-application notifications. Also
# comma-separated. Optional — falls back to CONTACT_TO_EMAIL if not set.
CAREER_TO_EMAIL=karriere@flinkfreight.de,careers@flinkfreight.eu

# ─── Split deployment (STRATO site + separate API) ──────────────────────────
# STRATO serves files but cannot run Node, so the site is split in two:
# the pages are uploaded to STRATO, and the form handler runs elsewhere.
#
# ON THE API DEPLOYMENT — which site origins may post to it. Comma-separated,
# no trailing slash. Anything not listed is refused by the browser.
ALLOWED_ORIGINS=https://flinkfreight.de,https://www.flinkfreight.de

# AT BUILD TIME for the STRATO bundle only — the API deployment's URL, baked
# into the JavaScript so the forms know where to post:
#   NEXT_PUBLIC_FORM_API_BASE=https://flinkfreight-api.vercel.app npm run build:static
# Leave unset for local dev and for the API deployment itself.

# ─── Where uploaded files go ────────────────────────────────────────────────
# Pick ONE destination.
#
# A) SharePoint (recommended) — files belong to the company rather than one
#    person, so access survives staff changes.
#    For the site https://contoso.sharepoint.com/sites/FlinkFreight :
#      MS_GRAPH_SITE_HOSTNAME=contoso.sharepoint.com
#      MS_GRAPH_SITE_PATH=sites/FlinkFreight
#    Leave MS_GRAPH_SITE_PATH empty to use the tenant's root site.
MS_GRAPH_SITE_HOSTNAME=
MS_GRAPH_SITE_PATH=

# B) OneDrive (fallback) — one mailbox's personal drive. Only used when
#    MS_GRAPH_SITE_HOSTNAME above is left empty. That user must have signed
#    in to onedrive.com at least once or the drive will not exist yet.
MS_GRAPH_USER_EMAIL=

# ─── Folder structure ───────────────────────────────────────────────────────
# Where each kind of upload is filed. Nested paths are fine; every level is
# created automatically on first use. Defaults shown — change freely.
MS_GRAPH_CAREER_FOLDER=Web/CVs
MS_GRAPH_CONTACT_FOLDER=Web/Queries/Transport Material

# ─── Resend (email) — NOT USED ──────────────────────────────────────────────
# Superseded by Microsoft 365 above, kept only for reference.
#
# Resend needs an MX record on a `send.` subdomain to verify a sending domain,
# and STRATO's DNS panel cannot create MX records for subdomains — only for
# the domain itself. That left both flinkfreight.de and .eu permanently
# unverified. Only revisit this if STRATO ever adds that record.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@flinkfreight.de

# ─── MongoDB — NOT USED ─────────────────────────────────────────────────────
# The database was removed on 2026-08-19; submissions go to SharePoint and
# email instead. The model/connection code is still in the repo, commented
# out, if it is ever needed again.
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/flinkfreight
