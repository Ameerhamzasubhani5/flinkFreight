# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — never commit real credentials.
# .env.local.example is committed as the template.
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling / agent scratch output — not part of the app
.gstack/
.claude/
graphify-out/

# generated documents — the markdown source in docs/ is the thing to edit.
# Regenerate with:  pdf generate docs/setup-guide.md docs/<name>.pdf
docs/*.pdf

# editor / OS noise
.idea/
.vscode/
Thumbs.db
*.swp
